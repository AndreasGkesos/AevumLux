<Page
    x:Class="AevumLux.Views.JwtDecoder.JwtDecoderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="JWT Decoder" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Paste any JWT to decode its header, payload and signature."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Token input -->
        <Grid Grid.Row="1" Padding="24,16,24,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.RawToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Paste your JWT here (eyJ…)"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="80"
                AcceptsReturn="False" />

            <Button
                Grid.Column="1"
                Content="Decode"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.DecodeCommand}"
                MinWidth="90"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Padding="24,16,24,24">

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8A4;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Paste a JWT above and press Decode"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.45"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Title="Could not decode token"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                VerticalAlignment="Top"
                IsClosable="True" />

            <!-- Result -->
            <Grid
                ColumnSpacing="16"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Header + expiry info -->
                <Grid Grid.Column="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Token type + expiry badge -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="8,3">
                            <TextBlock
                                Text="{x:Bind ViewModel.TokenTypeBadge, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.ExpiryStatus, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{x:Bind ViewModel.IsExpired, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!-- Header claims -->
                    <TextBlock
                        Grid.Row="1"
                        Text="Header"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border
                        Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HeaderClaims, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClaimRow">
                                        <Grid ColumnSpacing="8" Padding="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                                                <TextBlock
                                                    Text="{x:Bind Key}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    Opacity="0.9" />
                                                <TextBlock
                                                    Text="{x:Bind FriendlyName}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Opacity="0.45"
                                                    Visibility="{x:Bind HasFriendlyName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Value}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Right: Payload claims -->
                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Payload"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PayloadClaims, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClaimRow">
                                        <Grid ColumnSpacing="8" Padding="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                                                <TextBlock
                                                    Text="{x:Bind Key}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    Opacity="0.9" />
                                                <TextBlock
                                                    Text="{x:Bind FriendlyName}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Opacity="0.45"
                                                    Visibility="{x:Bind HasFriendlyName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Value}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>

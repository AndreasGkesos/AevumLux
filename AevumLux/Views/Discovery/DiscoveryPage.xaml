<Page
    x:Class="AevumLux.Views.Discovery.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Discovery Explorer" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Fetch and explore any provider's OpenID Connect discovery document."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Placeholder — full UI built in Phase 1 -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon Glyph="&#xE773;" FontSize="48" Opacity="0.3" />
            <TextBlock
                Text="Enter a provider URL above to fetch its discovery document."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.5"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Product identity. Version: bump every release, keep in sync with AevumLux.csproj's
       <Version>. UpgradeCode: set once, NEVER change after the first real release — this is
       how Windows Installer recognizes a new MSI as an upgrade of this product rather than a
       separate app. -->
  <Package
    Name="AevumLux"
    Manufacturer="Andreas Gkesos"
    Version="1.0.0"
    UpgradeCode="4c9f6e2a-2f7b-4b0e-9a3d-6b0c8e1a5f21"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of AevumLux is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install-time options, settable via the UI or command line (e.g. msiexec /i ... DELETE_USER_DATA=1). -->
    <Property Id="DELETE_USER_DATA" Value="0" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Where things get installed: Program Files\AevumLux\ with TestIdp\ as a subfolder,
         same relative layout the app expects in dev (see TestIdpProcessService). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AevumLux">
        <Directory Id="TESTIDPFOLDER" Name="TestIdp" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AevumLux" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- File payload, auto-harvested from the staging folder build-installer.bat produces —
         no per-file GUIDs to manage by hand; WiX generates stable component IDs from the file
         list as long as the folder shape doesn't change unexpectedly. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="staging\App\**\*.*">
        <Exclude Files="staging\App\TestIdp\**\*.*" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="TestIdpFiles" Directory="TESTIDPFOLDER">
      <Files Include="staging\App\TestIdp\**\*.*" />
    </ComponentGroup>

    <!-- Start Menu shortcut — always installed. Guid: set once, never change after shipping;
         changing it later makes Windows Installer treat it as a different component and can
         orphan the old shortcut on upgrade. -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="a2f4e1b8-6d3c-4a9f-8e2b-1c5d7f9a3b04">
      <Shortcut
        Id="StartMenuShortcutFile"
        Name="AevumLux"
        Target="[INSTALLFOLDER]AevumLux.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AevumLux"
        Name="StartMenuShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut — optional, controlled by INSTALLDESKTOPSHORTCUT (checked/on by
         default). Same GUID-stability rule as above. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="7e5a9c3f-1b8d-4e6a-9f2c-3a7b5d1e8c60" Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut
        Id="DesktopShortcutFile"
        Name="AevumLux"
        Target="[INSTALLFOLDER]AevumLux.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AevumLux"
        Name="DesktopShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Deletes %LOCALAPPDATA%\AevumLux (settings.json, aevumlux.db) on a true uninstall,
         only when the user opted in via the "Also delete my data" checkbox. Never fires on
         upgrade/repair. Same GUID-stability rule as the shortcuts above. -->
    <Component Id="DeleteUserData" Directory="INSTALLFOLDER" Guid="9b3d6f8a-4e1c-4a7b-8d2f-5c9a1b3e7f42" Condition="DELETE_USER_DATA = &quot;1&quot;">
      <util:RemoveFolderEx Id="RemoveUserDataFolder" Property="LOCALAPPDATADIR" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AevumLux"
        Name="DeleteUserDataRegistered"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <SetProperty Id="LOCALAPPDATADIR" Value="[LocalAppDataFolder]AevumLux" After="AppSearch" Sequence="both" />

    <!-- Ties everything above together into the one installable feature. -->
    <Feature Id="MainFeature" Title="AevumLux" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="TestIdpFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="DeleteUserData" />
    </Feature>

    <!-- Standard WiX install-directory-picker UI, showing the real MIT license (License.rtf,
         generated from the repo's LICENSE file — WixUI's license dialog requires RTF, not
         plain text). Doesn't yet expose the desktop-shortcut or delete-my-data checkboxes as
         actual dialog controls — those properties can only be set via command line for now
         (custom UI dialogs are a follow-up). -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>

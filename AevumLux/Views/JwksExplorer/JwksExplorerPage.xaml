<Page
    x:Class="AevumLux.Views.JwksExplorer.JwksExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="JWKS Explorer" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Visualise a provider's JSON Web Key Set. Paste a token to highlight the key that signed it."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Inputs -->
        <Grid Grid.Row="1" Padding="24,16,24,0" RowSpacing="8" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Row="0" Grid.Column="0"
                Text="{x:Bind ViewModel.JwksUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="JWKS URI (e.g. https://issuer/.well-known/jwks.json)" />

            <Button
                Grid.Row="0" Grid.Column="1"
                Content="Fetch"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.FetchCommand}"
                MinWidth="90"
                VerticalAlignment="Stretch" />

            <TextBox
                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Text="{x:Bind ViewModel.RawToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Optional: paste a JWT here to highlight the matching key by kid"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="60"
                AcceptsReturn="False" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Padding="24,16,24,24">

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE72E;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Enter a JWKS URI above and press Fetch"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.45"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Loading -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Width="36" Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Title="Could not fetch JWKS"
                VerticalAlignment="Top"
                IsClosable="True">
                <InfoBar.Content>
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Result -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Keys, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExplorerKey">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{x:Bind MatchesToken, Converter={StaticResource MatchBorderBrushConverter}}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="16"
                                Width="440"
                                Margin="0,0,12,12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE72E;"
                                            FontSize="18"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind KeyId}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Border
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind MatchesToken, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock
                                                Text="Matches token kid"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{x:Bind Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KeyDetail">
                                                <Grid ColumnSpacing="10" Padding="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind Label}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Opacity="0.6" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Value}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

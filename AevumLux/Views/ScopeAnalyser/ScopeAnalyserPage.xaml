<Page
    x:Class="AevumLux.Views.ScopeAnalyser.ScopeAnalyserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Scope Analyser" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Understand exactly what each scope in a token grants, and whether the token actually carries the claims it should."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Token input -->
        <Grid Grid.Row="1" Padding="24,16,24,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.RawToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Paste your JWT here (eyJ…)"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="80"
                AcceptsReturn="False" />

            <Button
                Grid.Column="1"
                Content="Analyse"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.AnalyseCommand}"
                MinWidth="90"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Padding="24,16,24,24">

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8EF;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Paste a JWT above and press Analyse"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.45"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Title="Could not analyse scopes"
                VerticalAlignment="Top"
                IsClosable="True">
                <InfoBar.Content>
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Result -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Scopes, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnalysedScope">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind Name}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                            VerticalAlignment="Center" />

                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsStandard, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                Text="Standard"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsStandard, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                            <TextBlock
                                                Text="Custom"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.7" />
                                        </Border>
                                    </Grid>

                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.7"
                                        TextWrapping="Wrap" />

                                    <ItemsControl
                                        ItemsSource="{x:Bind ExpectedClaims}"
                                        Visibility="{x:Bind HasExpectedClaims, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExpectedClaimCheck">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,14,0">
                                                    <FontIcon
                                                        Glyph="&#xE73E;"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Visibility="{x:Bind IsPresent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon
                                                        Glyph="&#xE711;"
                                                        FontSize="12"
                                                        Opacity="0.4"
                                                        Visibility="{x:Bind IsPresent, Converter={StaticResource BoolToInverseVisibilityConverter}}" />
                                                    <TextBlock
                                                        Text="{x:Bind DisplayText}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                                        Opacity="0.75"
                                                        IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

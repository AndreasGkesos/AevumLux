<Page
    x:Class="AevumLux.Views.ClaimsInspector.ClaimsInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Claims Inspector" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Inspect and categorise all claims from an ID or access token."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Token input -->
        <Grid Grid.Row="1" Padding="24,16,24,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.RawToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Paste your JWT here (eyJ…)"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="80"
                AcceptsReturn="False" />

            <Button
                Grid.Column="1"
                Content="Inspect"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.InspectCommand}"
                MinWidth="90"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Padding="24,16,24,24">

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE946;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Paste a JWT above and press Inspect"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.45"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Title="Could not inspect token"
                VerticalAlignment="Top"
                IsClosable="True">
                <InfoBar.Content>
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Result -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">

                    <!-- Observations -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{x:Bind ViewModel.HasObservations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Observations" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Observations, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Observation">
                                        <Grid ColumnSpacing="8" Padding="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE783;"
                                                FontSize="14"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{x:Bind IsCritical, Converter={StaticResource BoolToVisibilityConverter}}"
                                                VerticalAlignment="Top" />
                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE7BA;"
                                                FontSize="14"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Visibility="{x:Bind IsWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                VerticalAlignment="Top" />
                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE946;"
                                                FontSize="14"
                                                Opacity="0.6"
                                                Visibility="{x:Bind IsInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                                                VerticalAlignment="Top" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Message}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Scopes -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{x:Bind ViewModel.HasScopes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Scopes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Scopes, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,6,6">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClaimCategoryGroup">
                            <Expander
                                IsExpanded="True"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,12">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Expander.Header>

                                <ItemsControl ItemsSource="{x:Bind Claims}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InspectedClaim">
                                            <Grid ColumnSpacing="12" Padding="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                                                    <TextBlock
                                                        Text="{x:Bind Key}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                                        Opacity="0.9" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                                                    <TextBlock
                                                        Text="{x:Bind Value}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                    <TextBlock
                                                        Text="{x:Bind Description}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Opacity="0.5"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

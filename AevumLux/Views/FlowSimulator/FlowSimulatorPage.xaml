<Page
    x:Class="AevumLux.Views.FlowSimulator.FlowSimulatorPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels"
    xmlns:models="using:AevumLux.Core.Models">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Flow Simulator" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Walks through a real OAuth 2.0 / OIDC flow step by step against a real token endpoint. Nothing here is faked — pick a provider, pick a flow, and press Run."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel Spacing="16">

                <!-- Setup -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Setup" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <ComboBox
                            Header="Flow"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.SelectedFlow, Mode=TwoWay, Converter={StaticResource EnumToIndexConverter}}">
                            <ComboBoxItem Content="Client Credentials" />
                            <ComboBoxItem Content="Authorization Code + PKCE" />
                            <ComboBoxItem Content="Refresh Token" />
                            <ComboBoxItem Content="Device Code" />
                            <ComboBoxItem Content="Implicit ⚠ Deprecated" />
                            <ComboBoxItem Content="Resource Owner Password (ROPC) ⚠ Deprecated" />
                        </ComboBox>

                        <ComboBox
                            Header="Scenario provider (optional — autofills the fields below; edit freely after, or skip this and type your own for any IdP)"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Providers}"
                            SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.ShowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ProviderToNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox
                            Header="Issuer URL"
                            Text="{x:Bind ViewModel.IssuerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="https://your-idp.example.com" />

                        <TextBox
                            Header="Client ID"
                            Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Header="Redirect URI"
                            Text="{x:Bind ViewModel.RedirectUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, Converter={StaticResource FlowUsesRedirectUriToVisibilityConverter}}" />

                        <TextBox
                            Header="Scope"
                            Text="{x:Bind ViewModel.Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="e.g. api, or openid profile email" />

                        <TextBox
                            Text="{x:Bind ViewModel.ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=ClientCredentials, Converter={StaticResource FlowTypeToVisibilityConverter}}">
                            <TextBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Client Secret" />
                                    <TextBlock
                                        Text=" (not persisted — see SCENARIOS.md for scenario provider values; leave blank for public clients)"
                                        Visibility="{x:Bind ViewModel.ShowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </TextBox.Header>
                        </TextBox>

                        <TextBox
                            Header="Refresh Token"
                            Text="{x:Bind ViewModel.RefreshTokenInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Paste a refresh_token from a previous Authorization Code run"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=RefreshToken, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                        <TextBox
                            Text="{x:Bind ViewModel.ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=RefreshToken, Converter={StaticResource FlowTypeToVisibilityConverter}}">
                            <TextBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Client Secret" />
                                    <TextBlock
                                        Text=" (optional — only if this refresh client is confidential)"
                                        Visibility="{x:Bind ViewModel.ShowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </TextBox.Header>
                        </TextBox>

                        <TextBox
                            Header="Username"
                            Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="test-user (see SCENARIOS.md for the ropc- scenario's fixed test credentials)"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=ResourceOwnerPassword, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                        <PasswordBox
                            Header="Password"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="test-password"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=ResourceOwnerPassword, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                        <TextBox
                            Text="{x:Bind ViewModel.ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=ResourceOwnerPassword, Converter={StaticResource FlowTypeToVisibilityConverter}}">
                            <TextBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Client Secret" />
                                    <TextBlock
                                        Text=" (leave blank for public clients)"
                                        Visibility="{x:Bind ViewModel.ShowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </TextBox.Header>
                        </TextBox>

                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                Text="Authorization Code + PKCE opens a real sign-in popup — type in the scenario's test credentials from SCENARIOS.md to continue."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.6"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=AuthorizationCodePkce, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                            <TextBlock
                                Text="Device Code shows a user_code and opens a real sign-in popup on the verification URL — type in the scenario's test credentials from SCENARIOS.md, then the poll step picks up the approval within a couple of attempts."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.6"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=DeviceCode, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Deprecated pattern"
                                Message="This flow is real and will make a real call, but it demonstrates an anti-pattern that OAuth 2.1 and modern identity providers have moved away from. See the warning on the resulting step below for specifics."
                                Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=Implicit, Converter={StaticResource FlowTypeToVisibilityConverter}}" />

                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Deprecated pattern"
                                Message="This flow is real and will make a real call, but it demonstrates an anti-pattern that OAuth 2.1 and modern identity providers have moved away from. See the warning on the resulting step below for specifics."
                                Visibility="{x:Bind ViewModel.SelectedFlow, Mode=OneWay, ConverterParameter=ResourceOwnerPassword, Converter={StaticResource FlowTypeToVisibilityConverter}}" />
                        </StackPanel>

                        <Button
                            Content="Run"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RunCommand}"
                            MinWidth="100"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Padding="0,24,0,0"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE768;" FontSize="44" Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Pick a flow and provider above, then press Run to send real requests."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Opacity="0.45"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="32" Height="32"
                    HorizontalAlignment="Center" />

                <!-- Error -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    Title="Request failed">
                    <InfoBar.Content>
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </InfoBar.Content>
                </InfoBar>

                <!-- Step timeline: two-column swimlane. Each round-trip becomes two cards side
                     by side — AevumLux's request on the left, the identity provider's response
                     (and what it did to produce it) on the right — so both sides of every
                     exchange are visible, not just the client's half. -->
                <Grid
                    ColumnSpacing="16"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AevumLux (Client)" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.5" Margin="0,0,0,4" />
                    <TextBlock Grid.Column="1" Text="Identity Provider" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.5" Margin="0,0,0,4" />
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FlowStep">
                            <Grid ColumnSpacing="16" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: what AevumLux sent -->
                                <Border
                                    Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Visibility="{x:Bind Request, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind StepNumber}" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.5" />
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>

                                        <TextBlock
                                            Text="{x:Bind Explanation}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.6"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ElementName=RootPage, Path=ViewModel.ShowExplanations, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="URL" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" Margin="0,4,0,0" />
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                            <TextBlock
                                                Text="{x:Bind Request.Url}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                        </Border>

                                        <TextBlock Text="Breakdown" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" />
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Text="{x:Bind Request.Method}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    FontWeight="Bold"
                                                    IsTextSelectionEnabled="True" />
                                                <TextBlock
                                                    Text="{x:Bind Request.Body}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    TextWrapping="Wrap"
                                                    Opacity="0.85"
                                                    IsTextSelectionEnabled="True"
                                                    Margin="0,4,0,0"
                                                    Visibility="{x:Bind Request.Body, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Per-parameter explanations — explanations-on only -->
                                        <ItemsControl
                                            ItemsSource="{x:Bind Request.Parameters}"
                                            Visibility="{Binding ElementName=RootPage, Path=ViewModel.ShowExplanations, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ParameterExplanation">
                                                    <Border
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,0,0,6">
                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                                    FontWeight="Bold" />
                                                                <TextBlock
                                                                    Text="{x:Bind Value}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                                    Opacity="0.75"
                                                                    TextWrapping="Wrap"
                                                                    IsTextSelectionEnabled="True" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Text="{x:Bind Explanation}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Opacity="0.6"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Text="Copy as curl (may contain a real secret — do not share)"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.5" />
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                            <TextBlock
                                                Text="{x:Bind CurlCommand}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Right: what the identity provider did in response -->
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Visibility="{x:Bind Response, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind StepNumber}" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.5" />
                                            <TextBlock Text="Response" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Border
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{x:Bind Status, Converter={StaticResource FlowStepStatusToSuccessVisibilityConverter}}">
                                                <TextBlock Text="Success" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                            <Border
                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{x:Bind Status, Converter={StaticResource FlowStepStatusToFailedVisibilityConverter}}">
                                                <TextBlock Text="Failed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Status" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" />
                                            <TextBlock
                                                Text="{x:Bind Response.StatusCode}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="{x:Bind Status, Converter={StaticResource FlowStepStatusToSuccessVisibilityConverter}}" />
                                            <TextBlock
                                                Text="{x:Bind Response.StatusCode}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{x:Bind Status, Converter={StaticResource FlowStepStatusToFailedVisibilityConverter}}" />
                                        </StackPanel>

                                        <TextBlock
                                            Text="{x:Bind ResponseExplanation}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.7"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ResponseExplanation, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <TextBlock
                                            Text="{x:Bind Error.PlainEnglishExplanation}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Error, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <TextBlock Text="Raw Response" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" Margin="0,4,0,0" />
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                            <TextBlock
                                                Text="{x:Bind Response.Body}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                        </Border>

                                        <!-- Per-field explanations — explanations-on only -->
                                        <ItemsControl
                                            ItemsSource="{x:Bind Response.Parameters}"
                                            Visibility="{Binding ElementName=RootPage, Path=ViewModel.ShowExplanations, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ParameterExplanation">
                                                    <Border
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,4,0,0">
                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock
                                                                    Text="{x:Bind Name}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                                    FontWeight="Bold" />
                                                                <TextBlock
                                                                    Text="{x:Bind Value}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                                    Opacity="0.75"
                                                                    TextWrapping="Wrap"
                                                                    IsTextSelectionEnabled="True" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Text="{x:Bind Explanation}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Opacity="0.6"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border
                                            Visibility="{x:Bind DeprecationWarning, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Border
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Visibility="{Binding ElementName=RootPage, Path=ViewModel.ShowExplanations, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚠ Deprecated pattern" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock
                                                        Text="{x:Bind DeprecationWarning}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Final token -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.HasAccessToken, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Access Token" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LastAccessToken, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

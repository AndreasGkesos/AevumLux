<Page
    x:Class="AevumLux.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="App preferences, data management and version information."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Flow Simulator" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="AevumLux is primarily a debugging tool. Flow Simulator walks through live OAuth 2.0 / OIDC flows step by step against a real provider — useful for studying how the protocols work, less so for day-to-day token debugging. Off by default; turn it on if you want it in the sidebar."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Header="Show Flow Simulator in navigation"
                        IsOn="{x:Bind ViewModel.ShowFlowSimulator, Mode=TwoWay}"
                        OnContent="On"
                        OffContent="Off" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>

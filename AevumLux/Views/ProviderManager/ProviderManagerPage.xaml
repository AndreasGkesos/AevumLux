<Page
    x:Class="AevumLux.Views.ProviderManager.ProviderManagerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels"
    xmlns:models="using:AevumLux.Core.Models">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Provider Manager" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Save provider information here so you can quickly load it into the explorer features (Discovery Explorer, Token Validator, JWKS Explorer)."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="24,16,24,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- Saved providers list -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    Title="Something went wrong"
                    IsClosable="True">
                    <InfoBar.Content>
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </InfoBar.Content>
                </InfoBar>

                <Grid Grid.Row="1">
                    <!-- Empty state -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xECAA;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="No saved providers yet. Use the form to add one."
                            Style="{StaticResource BodyTextBlockStyle}"
                            Opacity="0.45"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OidcProvider">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind IssuerUrl}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    Opacity="0.7"
                                                    IsTextSelectionEnabled="True" />
                                                <TextBlock
                                                    Text="{x:Bind JwksUri}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                                    Opacity="0.5"
                                                    IsTextSelectionEnabled="True" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Content="Edit"
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.StartEditCommand}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Center" />

                                            <Button
                                                Grid.Column="2"
                                                Content="Delete"
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteCommand}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Add/edit form -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add Provider" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}" />
                    <TextBlock Text="Edit Provider" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBox
                        Header="Name"
                        Text="{x:Bind ViewModel.EditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. Nythorion Local" />

                    <TextBox
                        Header="Issuer URL"
                        Text="{x:Bind ViewModel.EditorIssuerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="http://localhost:7087" />
                    <TextBlock
                        Text="Discovery Explorer derives .well-known/openid-configuration from this automatically — no need to store it separately."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5"
                        TextWrapping="Wrap" />

                    <TextBox
                        Header="JWKS URI (optional)"
                        Text="{x:Bind ViewModel.EditorJwksUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="http://localhost:7087/.well-known/jwks" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}" />
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelEditCommand}"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Content="New"
                            Command="{x:Bind ViewModel.StartAddCommand}"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

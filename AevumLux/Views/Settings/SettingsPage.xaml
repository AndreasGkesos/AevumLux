<Page
    x:Class="AevumLux.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="App preferences, data management and version information."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Flow Explanations" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Flow Simulator is always available as a debugging tool — pick a flow, fill in the fields, press Run. This setting adds a Flow Explanations reference page to navigation, and shows Flow Simulator's scenario picker plus step-by-step explanations and deprecation warnings alongside the real request/response data. Turn off for a clean, no-overhead debugging view; turn on if you're learning how these flows work."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Header="Show flow explanations"
                        IsOn="{x:Bind ViewModel.ShowFlowExplanations, Mode=TwoWay}"
                        OnContent="On"
                        OffContent="Off" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>

<Page
    x:Class="AevumLux.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="TestIdpStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="App preferences, data management and version information."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="16">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Flow Explanations" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Flow Simulator is always available as a debugging tool — pick a flow, fill in the fields, press Run. This setting adds a Flow Explanations reference page to navigation, and shows Flow Simulator's scenario picker plus step-by-step explanations and deprecation warnings alongside the real request/response data. Turn off for a clean, no-overhead debugging view; turn on if you're learning how these flows work."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Header="Show flow explanations"
                        IsOn="{x:Bind ViewModel.ShowFlowExplanations, Mode=TwoWay}"
                        OnContent="On"
                        OffContent="Off" />
                </StackPanel>
            </Border>

            <Border
                Visibility="{x:Bind ViewModel.ShowFlowExplanations, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Test Identity Provider" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Flow Simulator scenarios run against a bundled local test IdP. It's published once on first run and managed here — start it before running a scenario, stop it when you're done."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse
                            Style="{StaticResource TestIdpStatusDotStyle}"
                            Fill="{x:Bind ViewModel.TestIdpStatus, Mode=OneWay, Converter={StaticResource TestIdpStatusToBrushConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.TestIdpStatus, Mode=OneWay, Converter={StaticResource TestIdpStatusToTextConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" Command="{x:Bind ViewModel.StartTestIdpCommand}" />
                        <Button Content="Stop" Command="{x:Bind ViewModel.StopTestIdpCommand}" />
                    </StackPanel>

                    <TextBlock
                        Visibility="{x:Bind ViewModel.TestIdpStatus, Mode=OneWay, Converter={StaticResource TestIdpRunningToVisibilityConverter}}"
                        Text="{x:Bind ViewModel.TestIdpLocalUrl, Mode=OneTime}"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.TestIdpExecutablePath, Mode=OneTime}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5"
                        TextWrapping="Wrap" />

                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="180">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.TestIdpLog}"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Logs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="AevumLux writes a rolling log file for diagnostics and troubleshooting."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                    <Button Content="Open Log Folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LogFolderPath, Mode=OneTime}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="AevumLux.Views.FlowSimulator.FlowSimulatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Flow Simulator" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Client Credentials — machine-to-machine authentication. A backend service authenticates as itself, using its own client ID and secret, to call an API. No user, no browser."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel Spacing="16">

                <!-- Setup -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Setup" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBox
                            Header="Token Endpoint"
                            Text="{x:Bind ViewModel.TokenEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="http://localhost:7087/connect/token" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="Client ID"
                                Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="cc-happy-path" />
                            <TextBox
                                Grid.Column="1"
                                Header="Client Secret"
                                Text="{x:Bind ViewModel.ClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="happy-path-secret" />
                        </Grid>

                        <TextBox
                            Header="Scope (optional)"
                            Text="{x:Bind ViewModel.Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="api" />

                        <Button
                            Content="Run"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RunCommand}"
                            MinWidth="100"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Padding="0,24,0,0"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE768;" FontSize="44" Opacity="0.25" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Fill in the setup above and press Run to send a real request."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Opacity="0.45"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="32" Height="32"
                    HorizontalAlignment="Center" />

                <!-- Error -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    Title="Request failed">
                    <InfoBar.Content>
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </InfoBar.Content>
                </InfoBar>

                <!-- Request -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Request Sent" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <TextBlock
                        Text="URL (Client Credentials sends its parameters in the POST body below, not the URL)"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.FullRequestUrl, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </Border>

                    <TextBlock
                        Text="Breakdown"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5"
                        Margin="0,6,0,0" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.RequestMethod, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                FontWeight="Bold"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TokenEndpoint, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Text="{x:Bind ViewModel.RequestHeaders, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                Opacity="0.6"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Text="{x:Bind ViewModel.RequestBody, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="Copy as curl (contains the real client secret — do not share)"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.CurlCommand, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </Border>
                </StackPanel>

                <!-- Response -->
                <Grid
                    ColumnSpacing="16"
                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: structured -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Response" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{x:Bind ViewModel.RequestSucceeded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ResponseStatusCode, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <Border
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{x:Bind ViewModel.RequestSucceeded, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ResponseStatusCode, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                        </StackPanel>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="{x:Bind ViewModel.HasAccessToken, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="10" Padding="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Token Type" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TokenType, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="10" Padding="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Expires In" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExpiresIn, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Access Token" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AccessToken, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: raw JSON -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Raw Response" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <TextBlock
                                Text="{x:Bind ViewModel.RawResponseJson, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

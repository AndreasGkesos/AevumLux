<Page
    x:Class="AevumLux.Views.TokenDiff.TokenDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AevumLux.ViewModels">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="2">
            <TextBlock Text="Token Diff" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Compare two tokens side by side — spot what was added, removed or changed."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>

        <!-- Token inputs -->
        <Grid Grid.Row="1" Padding="24,16,24,0" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Row="0" Grid.Column="0"
                Text="{x:Bind ViewModel.TokenA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Token A (eyJ…)"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="80"
                AcceptsReturn="False" />

            <TextBox
                Grid.Row="0" Grid.Column="1"
                Text="{x:Bind ViewModel.TokenB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Token B (eyJ…)"
                FontFamily="Cascadia Code, Consolas, Courier New"
                FontSize="12"
                TextWrapping="Wrap"
                MaxHeight="80"
                AcceptsReturn="False" />

            <Button
                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Compare"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.CompareCommand}"
                HorizontalAlignment="Left"
                MinWidth="120" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Padding="24,16,24,24">

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8C8;" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Paste two tokens above and press Compare"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.45"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Title="Could not compare tokens"
                VerticalAlignment="Top"
                IsClosable="True">
                <InfoBar.Content>
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Result -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">

                    <!-- Header diff -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Header" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HeaderDiff, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiffRow">
                                        <Grid ColumnSpacing="10" Padding="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsAdded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Added" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsRemoved, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Removed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Border>
                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsChanged, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Changed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Key}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                Opacity="0.9"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind ValueA}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Opacity="{x:Bind ValueOpacity}"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind ValueB}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Opacity="{x:Bind ValueOpacity}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Payload diff -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Payload" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PayloadDiff, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiffRow">
                                        <Grid ColumnSpacing="10" Padding="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsAdded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Added" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsRemoved, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Removed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Border>
                                            <Border
                                                Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind IsChanged, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Changed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Key}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                FontFamily="Cascadia Code, Consolas, Courier New"
                                                Opacity="0.9"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind ValueA}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Opacity="{x:Bind ValueOpacity}"
                                                VerticalAlignment="Center" />

                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind ValueB}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Opacity="{x:Bind ValueOpacity}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
